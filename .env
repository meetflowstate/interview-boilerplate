# This file is committed intentionally — local dev defaults only.
# All values match the docker-compose services so things work out of the box.

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=54329
DATABASE_URL=postgres://app:app@localhost:54329/app

# --- Redis ---
REDIS_PORT=63790
REDIS_URL=redis://localhost:63790

# --- OpenTelemetry / Jaeger ---
JAEGER_UI_PORT=16686
OTLP_HTTP_PORT=4318
OTLP_GRPC_PORT=4317
OTEL_SERVICE_NAME=api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- API server ---
PORT=3001
